{
  "name": "@openclawcash/eve",
  "version": "0.1.0",
  "type": "module",
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    }
  },
  "scripts": {
    "build": "eve extension build",
    "prepare": "eve extension build",
    "typecheck": "tsc"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.x",
    "eve": "1.0.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "eve": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "description": "Crypto wallets and escrow payments for eve agents. The agent gets an API key, never a private key; spending limits are enforced before anything is signed, and every payment needs the user's approval.",
  "license": "MIT",
  "homepage": "https://openclawcash.com",
  "keywords": [
    "eve",
    "eve-extension",
    "agents",
    "payments",
    "escrow",
    "crypto",
    "wallet",
    "solana",
    "base",
    "openclawcash"
  ],
  "author": "OpenClawCash",
  "publishConfig": {
    "access": "public"
  }
}
